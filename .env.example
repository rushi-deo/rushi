NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/erp
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES=15m
